# 统一换行：文本按 LF 存库
* text=auto eol=lf

# Windows 脚本除外
*.bat text eol=crlf
*.cmd text eol=crlf

# Gradle Wrapper 必须保持 LF + 可执行位，否则 Linux/macOS CI 直接跑不起来
gradlew text eol=lf
gradlew.bat text eol=crlf
*.sh text eol=lf
gradle/wrapper/gradle-wrapper.jar binary

# 二进制资源不做换行转换
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.otf binary
*.jar binary
